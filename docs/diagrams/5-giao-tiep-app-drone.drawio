<mxfile host="app.diagrams.net"><diagram id="hinh1" name="Hình 16 - Giao tiếp app và drone"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hA" value="&lt;b&gt;PHÍA ĐIỆN THOẠI (app ESP-Drone)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="160" y="8" width="400" height="30" as="geometry"/></mxCell><mxCell id="hB" value="&lt;b&gt;PHÍA DRONE (firmware ESP-Drone)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="8" width="400" height="30" as="geometry"/></mxCell><mxCell id="P0" value="Bắt đầu: bật drone, mở app ESP-Drone trên điện thoại Android" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="50" width="320" height="56" as="geometry"/></mxCell><mxCell id="P1" value="Dò Wi-Fi trên điện thoại, chọn mạng ESP-DRONE_xxxx, nhập mật khẩu 12345678" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="136" width="320" height="72" as="geometry"/></mxCell><mxCell id="P2" value="Bấm nút kết nối trong app" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="200" y="238" width="320" height="56" as="geometry"/></mxCell><mxCell id="P3" value="Đọc 2 cần ảo (Mode 2: cần trái = ga, xoay; cần phải = tiến-lùi, nghiêng trái-phải), áp giới hạn trong Cài đặt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="324" width="320" height="86" as="geometry"/></mxCell><mxCell id="P4" value="Gửi gói lệnh (roll, pitch, yaw, ga) qua UDP cổng 2390 tới 192.168.43.42; byte cuối là byte kiểm tra" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="440" width="320" height="86" as="geometry"/></mxCell><mxCell id="P5" value="Nhận dữ liệu drone gửi về, hiện trên app" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="556" width="320" height="60" as="geometry"/></mxCell><mxCell id="P6" value="Ngắt kết nối hoặc thoát app?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="200" y="646" width="320" height="110" as="geometry"/></mxCell><mxCell id="P7" value="Dừng gửi lệnh" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="200" y="786" width="320" height="56" as="geometry"/></mxCell><mxCell id="PN" value="Nếu mất sóng: drone tự cân bằng khi 0,5 giây không có lệnh mới và tắt motor sau 2 giây (Hình 15)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="872" width="520" height="64" as="geometry"/></mxCell><mxCell id="D0" value="Nhận gói UDP từ điện thoại (cổng 2390)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="50" width="320" height="56" as="geometry"/></mxCell><mxCell id="D1" value="Đúng byte kiểm tra và độ dài gói?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="136" width="320" height="110" as="geometry"/></mxCell><mxCell id="DE" value="Bỏ gói" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="155" width="130" height="72" as="geometry"/></mxCell><mxCell id="D2" value="Đưa vào hàng đợi CRTP, chuyển tới cổng lệnh điều khiển" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="276" width="320" height="72" as="geometry"/></mxCell><mxCell id="D3" value="Khóa ga: ga giữ bằng 0 cho đến khi nhận một gói có ga = 0 (mất lệnh quá 0,5 giây thì khóa lại); ga dưới 1000 coi như 0; tối đa 60000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="378" width="320" height="96" as="geometry"/></mxCell><mxCell id="D4" value="Roll, pitch là góc cần đạt (độ); yaw là tốc độ xoay cần đạt (độ/giây)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="504" width="320" height="72" as="geometry"/></mxCell><mxCell id="D5" value="Lưu lệnh kèm thời điểm nhận vào bộ nhận lệnh (commander); tác vụ ổn định đọc lệnh này (Hình 15)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="606" width="320" height="86" as="geometry"/></mxCell><mxCell id="D6" value="Gửi dữ liệu phản hồi về điện thoại qua UDP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="722" width="320" height="60" as="geometry"/></mxCell><mxCell id="D7" value="Chờ gói tiếp theo" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="740" y="812" width="320" height="56" as="geometry"/></mxCell><mxCell id="l6n" value="&lt;b&gt;Không&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="672" width="50" height="20" as="geometry"/></mxCell><mxCell id="l6c" value="&lt;b&gt;Có&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="366" y="760" width="30" height="20" as="geometry"/></mxCell><mxCell id="l1n" value="&lt;b&gt;Sai&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1062" y="166" width="30" height="20" as="geometry"/></mxCell><mxCell id="l1c" value="&lt;b&gt;Đúng&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="906" y="250" width="40" height="20" as="geometry"/></mxCell><mxCell id="lg" value="&lt;b&gt;gói lệnh&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="250" width="66" height="20" as="geometry"/></mxCell><mxCell id="ld" value="&lt;b&gt;dữ liệu về&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="556" y="660" width="76" height="20" as="geometry"/></mxCell><mxCell id="e_P0_P1" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="P0" target="P1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_P1_P2" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="P1" target="P2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_P2_P3" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="P2" target="P3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_P3_P4" style="endArrow=classic;html=1;stro