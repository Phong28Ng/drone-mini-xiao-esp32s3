<mxfile host="app.diagrams.net"><diagram id="hinh1" name="Hình 14 - Chương trình chính"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hA" value="&lt;b&gt;A. KHỞI ĐỘNG (chạy một lần)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="170" y="8" width="420" height="30" as="geometry"/></mxCell><mxCell id="hB" value="&lt;b&gt;B. CÁC TÁC VỤ CHẠY SONG SONG (FreeRTOS)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="730" y="8" width="390" height="30" as="geometry"/></mxCell><mxCell id="A0" value="Bắt đầu: cấp điện hoặc bấm reset" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="50" width="300" height="56" as="geometry"/></mxCell><mxCell id="A1" value="Khởi tạo bộ nhớ flash (NVS) để dùng cho Wi-Fi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="136" width="300" height="56" as="geometry"/></mxCell><mxCell id="A2" value="Firmware đúng phần cứng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="222" width="300" height="100" as="geometry"/></mxCell><mxCell id="E2" value="Sai phần cứng: dừng chương trình" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="236" width="170" height="72" as="geometry"/></mxCell><mxCell id="A3" value="Tạo tác vụ hệ thống: bật LED đỏ, phát Wi-Fi ESP-DRONE_xxxx (mật khẩu 12345678), chờ 0,5 giây" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="352" width="300" height="76" as="geometry"/></mxCell><mxCell id="A4" value="Khởi tạo liên kết Wi-Fi – CRTP, ADC đo pin, LED, quản lý pin, bộ nhận lệnh từ app" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="458" width="300" height="76" as="geometry"/></mxCell><mxCell id="A5" value="Khởi tạo bộ ổn định: cảm biến MPU6050 (sau giây thứ 2), bộ lọc góc, PID, 4 motor PWM 15 kHz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="564" width="300" height="76" as="geometry"/></mxCell><mxCell id="A6" value="Kết nối được MPU6050?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="670" width="300" height="100" as="geometry"/></mxCell><mxCell id="E6" value="Báo lỗi, chip tự khởi động lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="684" width="170" height="72" as="geometry"/></mxCell><mxCell id="A7" value="Tự kiểm tra các khối: thử LED, MPU6050 (tối đa 3 giây), quay thử lần lượt M1 → M4 ở 20% công suất, mỗi motor 0,2 giây" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="800" width="300" height="90" as="geometry"/></mxCell><mxCell id="A8" value="Tất cả đạt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="920" width="300" height="100" as="geometry"/></mxCell><mxCell id="E8" value="Không cho bay, báo lỗi lặp lại mỗi 2 giây (LED xanh lá không chớp 5 lần)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="934" width="170" height="72" as="geometry"/></mxCell><mxCell id="A9" value="Cho các tác vụ còn lại bắt đầu chạy; LED xanh lá chớp 5 lần" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="1050" width="300" height="60" as="geometry"/></mxCell><mxCell id="CA" value="A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="362" y="1140" width="36" height="36" as="geometry"/></mxCell><mxCell id="tA" value="(tiếp tục ở cột B)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1180" width="160" height="20" as="geometry"/></mxCell><mxCell id="CB" value="A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="907" y="50" width="36" height="36" as="geometry"/></mxCell><mxCell id="B0" value="FreeRTOS chạy đồng thời các tác vụ; tác vụ ưu tiên cao hơn được chạy trước" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="116" width="330" height="60" as="geometry"/></mxCell><mxCell id="B1" value="Tác vụ cảm biến (ưu tiên 4): chờ tín hiệu ngắt của MPU6050 ở GPIO8 (1000 lần/giây), đọc I2C, trừ sai lệch gyro (tự hiệu chỉnh khi drone đứng yên), lọc nhiễu" style="shape=process;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="216" width="330" height="110" as="geometry"/></mxCell><mxCell id="B2" value="Tác vụ ổn định (ưu tiên 5, Hình 15): ước lượng góc → PID → 4 motor" style="shape=process;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="356" width="330" height="76" as="geometry"/></mxCell><mxCell id="B3" value="Tác vụ Wi-Fi/UDP và CRTP (ưu tiên 2–3, chạy từ lúc khởi tạo, Hình 16): nhận lệnh từ app, gửi dữ liệu về" style="shape=process;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="462" width="330" height="76" as="geometry"/></mxCell><mxCell id="B4" value="Tác vụ quản lý pin (ưu tiên 0): đo pin 10 lần/giây; dưới 3,2 V quá 5 giây thì bật LED đỏ" style="shape=process;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="568" width="330" height="76" as="geometry"/></mxCell><mxCell id="B5" value="Tác vụ hệ thống (ưu tiên 2): chạy các công việc nền" style="shape=process;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="674" width="330" height="64" as="geometry"/></mxCell><mxCell id="l2n" value="&lt;b&gt;Không&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="184" y="248" width="50" height="20" as="geometry"/></mxCell><mxCell id="l2c" value="&lt;b&gt;Có&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="386" y="326" width="30" height="20" as="geometry"/></mxCell><mxCell id="l6n" value="&lt;b&gt;Không&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="184" y="696" width="50" height="20" as="geometry"/></mxCell><mxCell id="l6c" value="&lt;b&gt;Có&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="386" y="774" width="30" height="20" as="geometry"/></mxCell><mxCell id="l8n" value="&lt;b&gt;Không&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="184" y="946" width="50" height="20" as="geometry"/></mxCell><mxCell id="l8c" value="&lt;b&gt;Có&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="386" y="1024" width="30" height="20" as="geometry"/></mxCell><mxCell id="e_A0_A1" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A0" target="A1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_A1_A2" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A1" target="A2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_A2_A3" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A2" target="A3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_A3_A4" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A3" target="A4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_A4_A5" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A4" target="A5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_A5_A6" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A5" target="A6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_A6_A7" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" p