<mxfile host="app.diagrams.net"><diagram id="hinh1" name="Hình 15 - Vòng ổn định"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hA" value="&lt;b&gt;A. CHUẨN BỊ VÀ ƯỚC LƯỢNG GÓC&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="170" y="8" width="420" height="30" as="geometry"/></mxCell><mxCell id="hB" value="&lt;b&gt;B. ĐIỀU KHIỂN PID VÀ 4 MOTOR&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="8" width="380" height="30" as="geometry"/></mxCell><mxCell id="L0" value="Bắt đầu tác vụ ổn định" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="50" width="300" height="56" as="geometry"/></mxCell><mxCell id="L1" value="Chờ hệ thống khởi động và tự kiểm tra xong" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="136" width="300" height="56" as="geometry"/></mxCell><mxCell id="L2" value="Gyro đã tự hiệu chỉnh xong? (drone đứng yên)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="222" width="300" height="110" as="geometry"/></mxCell><mxCell id="W2" value="Chưa xong: chờ 1 ms rồi kiểm tra lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="241" width="170" height="72" as="geometry"/></mxCell><mxCell id="L3" value="Chờ dữ liệu cảm biến mới (1000 lần/giây)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="362" width="300" height="60" as="geometry"/></mxCell><mxCell id="L4" value="Tính góc roll, pitch, yaw bằng bộ lọc Mahony (cập nhật 250 lần/giây; Kp 0,4; Ki 0,001)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="452" width="300" height="76" as="geometry"/></mxCell><mxCell id="L5" value="Lấy lệnh mới nhất từ app (roll, pitch, yaw, ga)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="558" width="300" height="60" as="geometry"/></mxCell><mxCell id="L6" value="Lệnh cũ hơn 0,5 giây?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="648" width="300" height="110" as="geometry"/></mxCell><mxCell id="E6" value="Mất lệnh: góc đích = 0° để tự cân bằng, giữ ga; quá 2 giây: ga = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="667" width="170" height="90" as="geometry"/></mxCell><mxCell id="L7" value="Kiểm tra lật úp (khi motor đang quay): gia tốc trục Z dưới −0,5 g 30 lần liên tiếp thì bật dừng khẩn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="798" width="300" height="76" as="geometry"/></mxCell><mxCell id="CA" value="A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="362" y="904" width="36" height="36" as="geometry"/></mxCell><mxCell id="tA" value="(tiếp tục ở cột B)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="944" width="160" height="20" as="geometry"/></mxCell><mxCell id="CB" value="A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="892" y="50" width="36" height="36" as="geometry"/></mxCell><mxCell id="R1" value="Đến lượt tính PID? (500 lần/giây)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="106" width="300" height="110" as="geometry"/></mxCell><mxCell id="R2" value="PID vòng ngoài (góc): góc đích − góc đo → tốc độ quay đích (roll/pitch: Kp 5,3; Ki 2,5)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="246" width="300" height="86" as="geometry"/></mxCell><mxCell id="R3" value="PID vòng trong (tốc độ quay): tốc độ đích − gyro → mức chỉnh (roll/pitch: Kp 190; Ki 440; Kd 2,6)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="362" width="300" height="86" as="geometry"/></mxCell><mxCell id="R4" value="Ga = 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="478" width="300" height="100" as="geometry"/></mxCell><mxCell id="E4" value="Đầu ra = 0, xóa tích phân các PID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="548" y="493" width="180" height="70" as="geometry"/></mxCell><mxCell id="R5" value="Dừng khẩn? (lật úp hoặc lệnh dừng)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="608" width="300" height="110" as="geometry"/></mxCell><mxCell id="E5" value="Tắt cả 4 motor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1095" y="627" width="130" height="72" as="geometry"/></mxCell><mxCell id="R6" value="Trộn 4 motor kiểu X: M1 = T − r + p + y; M2 = T − r − p − y; M3 = T + r − p + y; M4 = T + r + p − y (r = roll/2, p = pitch/2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="748" width="300" height="96" as="geometry"/></mxCell><mxCell id="R7" value="Xuất PWM 15 kHz (8 bit) ra GPIO 7, 4, 3, 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="874" width="300" height="60" as="geometry"/></mxCell><mxCell id="R8" value="Quay lại chờ dữ liệu cảm biến (cột A)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="964" width="300" height="56" as="geometry"/></mxCell><mxCell id="l2n" value="&lt;b&gt;Không&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="184" y="252" width="50" height="20" as="geometry"/></mxCell><mxCell id="l2c" value="&lt;b&gt;Có&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="386" y="336" width="30" height="20" as="geometry"/></mxCell><mxCell id="l6c" value="&lt;b&gt;Có&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="186" y="680" width="30" height="20" as="geometry"/></mxCell><mxCell id="l6n" value="&lt;b&gt;Không&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="386" y="762" width="50" height="20" as="geometry"/></mxCell><mxCell id="l1n" value="&lt;b&gt;Không&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1066" y="138" width="50" height="20" as="geometry"/></mxCe