<mxfile host="app.diagrams.net"><diagram id="hinh1" name="Hình 1 - Sơ đồ khối tổng quát"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pin" value="Pin LiPo 1S (3,7 V)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="220" height="80" as="geometry"/></mxCell><mxCell id="ng" value="Đầu nối pin J1 và đường VBAT trên bo PCB" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="50" width="230" height="80" as="geometry"/></mxCell><mxCell id="esp" value="&lt;div&gt;&lt;b&gt;XIAO ESP32-S3&lt;br&gt;firmware ESP-Drone&lt;/b&gt;&lt;br&gt;đọc cảm biến, tính PID, điều khiển motor, phát Wi-Fi ESP-DRONE, đo pin&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="315" y="230" width="260" height="110" as="geometry"/></mxCell><mxCell id="ph" value="&lt;div&gt;Điện thoại Android&lt;br&gt;app ESP-Drone (cần ảo, cài đặt)&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="220" height="110" as="geometry"/></mxCell><mxCell id="mpu" value="Cảm biến MPU6050: đo độ nghiêng và tốc độ quay" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="315" y="440" width="260" height="80" as="geometry"/></mxCell><mxCell id="led" value="Đèn LED: 2 đèn trạng thái, 4 đèn định hướng" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="220" height="80" as="geometry"/></mxCell><mxCell id="pw" value="4 mạch công suất (MOSFET + diode): đóng/ngắt dòng điện cho từng motor" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="230" width="240" height="110" as="geometry"/></mxCell><mxCell id="mt" value="4 motor + cánh quạt: tạo lực nâng và điều khiển" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="440" width="240" height="80" as="geometry"/></mxCell><mxCell id="req" value="&lt;div&gt;&lt;b&gt;Yêu cầu chính:&lt;/b&gt; (1) đọc cảm biến 1000 lần/giây, tính PID 500 lần/giây; (2) điều khiển công suất 4 motor độc lập; (3) nhận lệnh từ app qua Wi-Fi; (4) an toàn: khóa ga đến khi kéo ga về 0, tự cân bằng khi mất lệnh 0,5 giây, tắt motor sau 2 giây, dừng khẩn khi drone lật úp.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="570" width="900" height="96" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;Wi-Fi (UDP)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="243" y="252" width="72" height="20" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;VBAT → XIAO ESP32-S3 (ổn áp 3,3 V)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="452" y="152" width="300" height="20" as="geometry"/></mxCell><mxCell id="l3" value="&lt;b&gt;cấp điện cho motor&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="62" width="130" height="20" as="geometry"/></mxCell><mxCell id="l4" value="&lt;b&gt;tín hiệu điều khiển&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="238" width="100" height="20" as="geometry"/></mxCell><mxCell id="l5" value="&lt;b&gt;dữ liệu + tín hiệu ngắt&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="380" width="150" height="20" as="geometry"/></mxCell><mxCell id="l6" value="&lt;b&gt;đèn trạng thái&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="236" y="372" width="100" height="20" as="geometry"/></mxCell><mxCell id="l7" value="&lt;b&gt;công suất từng motor&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="812" y="372" width="110" height="20" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pin" target="ng"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ng" target="esp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ng" target="pw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="90"/></Array></mxGeometry></mxCell><mxCell id="e4" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;startArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ph" target="esp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" 