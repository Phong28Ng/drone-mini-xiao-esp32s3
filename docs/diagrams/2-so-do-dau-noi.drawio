<mxfile host="app.diagrams.net"><diagram id="hinh1" name="Hình 7 - Sơ đồ đấu nối phần cứng"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="esp" value="&lt;div&gt;&lt;b&gt;Seeed XIAO ESP32-S3&lt;/b&gt;&lt;br&gt;(đọc cảm biến, tính toán, phát xung PWM)&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="60" width="190" height="460" as="geometry"/></mxCell><mxCell id="mpu" value="&lt;div&gt;Cảm biến MPU6050 (U1, hàn trên bo)&lt;br&gt;đo độ nghiêng và tốc độ quay&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="180" height="110" as="geometry"/></mxCell><mxCell id="bat" value="&lt;div&gt;Mạch đo pin&lt;br&gt;R8, R9 10 kΩ chia đôi điện áp pin&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="180" height="110" as="geometry"/></mxCell><mxCell id="ledr" value="LED đỏ D5 (pin yếu, lỗi)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="180" height="60" as="geometry"/></mxCell><mxCell id="ledg" value="LED xanh lá D6 (tự kiểm tra, nhận lệnh)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="180" height="60" as="geometry"/></mxCell><mxCell id="q0" value="&lt;div&gt;MOSFET KSI2300DS&lt;br&gt;(Q1)&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="70" width="140" height="70" as="geometry"/></mxCell><mxCell id="m0" value="&lt;div&gt;Motor M1 (trước phải)&lt;br&gt;+ diode 1N4148WS, tụ 0,1 µF&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="70" width="160" height="70" as="geometry"/></mxCell><mxCell id="q1" value="&lt;div&gt;MOSFET KSI2300DS&lt;br&gt;(Q2)&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="170" width="140" height="70" as="geometry"/></mxCell><mxCell id="m1" value="&lt;div&gt;Motor M2 (sau phải)&lt;br&gt;+ diode 1N4148WS, tụ 0,1 µF&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="170" width="160" height="70" as="geometry"/></mxCell><mxCell id="q2" value="&lt;div&gt;MOSFET KSI2300DS&lt;br&gt;(Q3)&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="270" width="140" height="70" as="geometry"/></mxCell><mxCell id="m2" value="&lt;div&gt;Motor M3 (sau trái)&lt;br&gt;+ diode 1N4148WS, tụ 0,1 µF&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="270" width="160" height="70" as="geometry"/></mxCell><mxCell id="q3" value="&lt;div&gt;MOSFET KSI2300DS&lt;br&gt;(Q4)&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="370" width="140" height="70" as="geometry"/></mxCell><mxCell id="m3" value="&lt;div&gt;Motor M4 (trước trái)&lt;br&gt;+ diode 1N4148WS, tụ 0,1 µF&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="370" width="160" height="70" as="geometry"/></mxCell><mxCell id="nav" value="&lt;div&gt;4 đèn định hướng&lt;br&gt;(2 trắng trước, 2 đỏ sau), sáng liên tục&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="545" width="180" height="80" as="geometry"/></mxCell><mxCell id="rail" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="60" width="20" height="400" as="geometry"/></mxCell><mxCell id="pin" value="&lt;div&gt;Pin LiPo 1S (3,7 V)&lt;br&gt;cắm vào J1 (JST-PH)&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="880" y="560" width="200" height="100" as="geometry"/></mxCell><mxCell id="note" value="&lt;div&gt;&lt;b&gt;Ghi chú:&lt;/b&gt; mỗi motor có 1 MOSFET KSI2300DS đặt phía GND: chân G nhận xung PWM từ XIAO ESP32-S3 (điện trở 10 kΩ kéo xuống GND), chân S nối GND, chân D nối cực âm motor. Diode 1N4148WS và tụ 0,1 µF mắc song song hai đầu motor. Cực dương 4 motor nối VBAT. XIAO ESP32-S3 tạo 3,3 V cho MPU6050 và các đèn. Chân INT của MPU6050 nối GPIO8 vì firmware dùng tín hiệu ngắt này để đọc cảm biến 1000 lần/giây.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="1060" height="110" as="geometry"/></mxCell><mxCell id="lr" value="&lt;b&gt;Nguồn + (VBAT)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="30" width="160" height="20" as="geometry"/></mxCell><mxCell id="g0" value="&lt;b&gt;GPIO7&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="73" width="90" height="20" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;GPIO4&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="173" width="90" height="20" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;GPIO3&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="273" width="90" height="20" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;GPIO1&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="373" width="90" height="20" as="geometry"/></mxCell><mxCell id="li" value="&lt;b&gt;I2C: SDA=GPIO5, SCL=GPIO6; INT=GPIO8 (kéo lên 10 kΩ)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="118" width="120" height="68" as="geometry"/></mxCell><mxCell id="la" value="&lt;b&gt;ADC: GPIO2&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="232" width="120" height="20" as="geometry"/></mxCell><mxCell id="lg1" value="&lt;b&gt;GPIO43&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="368" width="120" height="20" as="geometry"/></mxCell><mxCell id="lg2" value="&lt;b&gt;GPIO9&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="448" width="120" height="20" as="geometry"/></mxCell><mxCell id="lp" value="&lt;b&gt;dây BAT+/BAT− tới pad pin XIAO ESP32-S3&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="580" width="330" height="20" as="geometry"/></mxCell><mxCell id="l33" value="&lt;b&gt;3,3 V&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="205" y="560" width="60" height="20" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;startArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.11956521739130435;entryDx=0;entryDy=0;" edge="1" parent="1" source="mpu" target="esp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.44565217391304346;entryDx=0;entryDy=0;" edge="1" parent="1" source="bat" target="esp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0;exitY=0.717391304347826;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="esp" target="ledr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0;exitY=0.8913043478260869;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="esp" target="ledg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a0" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=1;exitY=0.09782608695652174;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="esp" target="q0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b0" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q0" target="m0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c0" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0;exitY=0.1