mxCell><mxCell id="b3" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q3" target="m3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0;exitY=0.8625;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rail" target="m3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="esp" target="nav"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="348" y="585"/></Array></mxGeometry></mxCell><mxCell id="e5" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pin" target="rail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" style="endArrow=classic;html=1;strokeWidth=1.5;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pin" target="esp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="415" y="610"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>